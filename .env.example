DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SUPERVISEUR_USERNAME=superviseur
DJANGO_SUPERVISEUR_PASSWORD=change-me-now
DJANGO_SUPERVISEUR_EMAIL=superviseur@example.com
DJANGO_SUPERVISEUR_NOM=Superviseur BAM
DB_ENGINE=mysql
MYSQL_DATABASE=bam_supervise
MYSQL_USER=bam_user
MYSQL_PASSWORD=bam_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=db
MYSQL_PORT=3306
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.local
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=bam-supervise@example.local
