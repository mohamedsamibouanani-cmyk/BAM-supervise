DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_PRELOAD=0
DJANGO_BEHIND_HTTPS_PROXY=0
DJANGO_SESSION_AGE=28800
BAM_DATA_ENCRYPTION_KEY=change-this-data-encryption-key-in-production

DJANGO_SUPERVISEUR_USERNAME=superviseur
DJANGO_SUPERVISEUR_PASSWORD=change-me-now
DJANGO_SUPERVISEUR_EMAIL=superviseur@example.com
DJANGO_SUPERVISEUR_NOM=Superviseur BAM

DB_ENGINE=mysql
MYSQL_DATABASE=bam_supervise
MYSQL_USER=bam_user
MYSQL_PASSWORD=bam_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# SMTP de test BAM Supervise via le compte Google Workspace UIT dedie a l'application.
# Ne jamais commiter le mot de passe d'application Google dans Git.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=mohamedsami.bouanani@uit.ac.ma
EMAIL_HOST_PASSWORD=put-google-app-password-here-locally
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=20
EMAIL_FROM_NAME=BAM Supervise
EMAIL_FROM_ADDRESS=mohamedsami.bouanani@uit.ac.ma
EMAIL_REPLY_TO=mohamedsami.bouanani@uit.ac.ma
EMAIL_ALLOW_SIMULATED_DELIVERY=0
